# =============================================================================
# .gitignore — Headless CMS Monorepo
# Cobre: Node.js, Next.js, Directus, Docker volumes, credenciais e SO
# =============================================================================

# =============================================================================
# 🔐 SEGURANÇA — Variáveis de Ambiente e Credenciais (NUNCA commitar)
# =============================================================================
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env*.local
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/

# =============================================================================
# 🐳 DOCKER — Volumes e dados persistentes locais
# =============================================================================
# Volume do PostgreSQL (dados do banco local — nunca versionar)
pgdata/
postgres-data/
.postgres/

# Uploads do Directus (arquivos de mídia enviados pelo painel)
uploads/*
!uploads/.gitkeep

# Extensões compiladas (manter a pasta, ignorar builds)
extensions/dist/

# =============================================================================
# ⚛️  NEXT.JS — Artefatos de build e cache
# =============================================================================
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/next-env.d.ts

# =============================================================================
# 📦 NODE.JS — Dependências (frontend e qualquer futuro pacote no monorepo)
# =============================================================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/
.npm/
package-lock.json
yarn.lock
pnpm-lock.yaml

# =============================================================================
# 🧪 TESTES e COBERTURA
# =============================================================================
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
.playwright/

# =============================================================================
# 🛠️ IDEs e EDITORES
# =============================================================================
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml
*.iws

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# =============================================================================
# 💻 SISTEMA OPERACIONAL
# =============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# =============================================================================
# 📊 LOGS e TEMPORÁRIOS
# =============================================================================
*.log
logs/
*.tmp
*.temp
tmp/
temp/
.cache/
.parcel-cache/
dist/
.turbo/

# =============================================================================
# 🔑 CERTIFICADOS e CHAVES SSH
# =============================================================================
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
known_hosts

# =============================================================================
# 📋 OUTROS
# =============================================================================
*.tsbuildinfo
.eslintcache
.stylelintcache
Dockerfile.prod
